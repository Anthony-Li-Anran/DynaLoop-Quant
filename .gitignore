# Logs
*.log

# Experiments, datasets and test suites are not part of the published source release.
# Research artifacts are reproducible from the documented protocols; raw data and
# checkpoints stay local.
experiments/
test_datasets/
tests/
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx
frontend/src/test/
frontend/test/

# Keep pytest fixtures/support only if a source module imports them (none do).
